+static NvBool
+nv_cmp90hx_is_target(struct pci_dev *gpu)
+{
+    return (gpu != NULL) &&
+           (gpu->device == 0x220d) &&
+           (gpu->subsystem_vendor == 0x10de) &&
+           (gpu->subsystem_device == 0x1555);
+}
